[Unit]
Description=Portwarden inventory (ASM_EVENTS -> PostgreSQL, read-only API, host silence, cloud look-up)
Documentation=https://github.com/thapr0digy/portwarden
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# The API binds 127.0.0.1:8740 by default (config "listen").
# Secrets are passed as systemd credentials (readable only by this service, under
# /run/credentials/portwarden-inventory.service/); the config file names those paths.
LoadCredential=nats.nk:/etc/portwarden/nats/inventory.nk
LoadCredential=dsn:/etc/portwarden/inventory.dsn
LoadCredential=token:/etc/portwarden/inventory.token
# GCP look-up with a service-account key (cloud.gcp.key_file =
# /run/credentials/portwarden-inventory.service/gcp-key):
#LoadCredential=gcp-key:/etc/portwarden/gcp-key.json
# Azure look-up with an app registration's client secret (cloud.azure.client_secret_file =
# /run/credentials/portwarden-inventory.service/azure-secret):
#LoadCredential=azure-secret:/etc/portwarden/azure-secret
# Several instances may run (on other machines, same config and database): one leads,
# the others stand by and serve reads (README "Running a standby"). On losing the lead it
# exits 1 and Restart= brings it back as a standby.
ExecStart=/usr/bin/portwarden-inventory --config /etc/portwarden/inventory.json
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
