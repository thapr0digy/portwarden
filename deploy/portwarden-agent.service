[Unit]
Description=Portwarden agent (TCP/UDP listener inventory and exposure to NATS)
DefaultDependencies=no
Before=network-pre.target shutdown.target
# Needed for a clean SIGTERM (and spool flush) at shutdown now default dependencies are off.
Conflicts=shutdown.target
Wants=network-pre.target
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Static system user, created by dev/install-agent.sh:
#   useradd --system --no-create-home --shell /usr/sbin/nologin portwarden-agent
User=portwarden-agent
# Unsent messages are spooled here (64 MiB cap by default) and survive restarts.
# systemd creates /var/lib/portwarden owned by User, mode 0700, and keeps it writable
# under ProtectSystem=strict.
StateDirectory=portwarden
StateDirectoryMode=0700
ExecStart=/usr/local/bin/portwarden-agent --spool-dir /var/lib/portwarden/spool
# CAP_NET_ADMIN: read the firewall (nft list ruleset, iptables-nft-save) and join the
# nf_tables change-notification group; both fail with EPERM without it. The agent runs
# nft/iptables-save as children, which inherit the ambient set.
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_NET_ADMIN
NoNewPrivileges=yes
# Both leave /proc and /sys readable. ProtectKernelTunables is left off on purpose:
# it hides /proc/kallsyms.
ProtectSystem=strict
ProtectHome=yes
Restart=always
RestartSec=2s

[Install]
WantedBy=sysinit.target
