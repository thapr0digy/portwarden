[Unit]
Description=Portwarden alerter (newly reachable listeners, confirmations, host silence -> webhook)
Documentation=https://github.com/thapr0digy/portwarden
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Secrets are passed as systemd credentials (readable only by this service, under
# /run/credentials/portwarden-alerter.service/); the config file names those paths.
LoadCredential=nats.nk:/etc/portwarden/nats/alerter.nk
LoadCredential=webhook.secret:/etc/portwarden/alerter.webhook-secret
LoadCredential=dsn:/etc/portwarden/alerter.dsn
# Several instances may run (on other machines, same config and database): one leads,
# the others stand by (README "Running a standby"). On losing the lead it exits 1 and
# Restart= brings it back as a standby.
# /usr/bin/portwarden-alerter is the backend .deb's symlink to /usr/bin/portwarden, which runs
# its alerter subcommand (`portwarden alerter`) under this name.
ExecStart=/usr/bin/portwarden-alerter --config /etc/portwarden/alerter.json
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
