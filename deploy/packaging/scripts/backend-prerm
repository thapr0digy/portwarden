#!/bin/sh
# portwarden-backend prerm: stop and disable the services on removal.
set -e

if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
	for unit in portwarden-inventory portwarden-alerter portwarden-verifier; do
		systemctl stop "$unit.service" >/dev/null || true
		systemctl disable "$unit.service" >/dev/null || true
	done
fi
exit 0
