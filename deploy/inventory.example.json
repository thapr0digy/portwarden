{
  "nats": {
    "url": "tls://nats.example:4222",
    "nkey_file": "/run/credentials/portwarden-inventory.service/nats.nk",
    "ca_file": "/etc/portwarden/nats-ca.pem"
  },
  "postgres_dsn_file": "/run/credentials/portwarden-inventory.service/dsn",
  "listen": "127.0.0.1:8740",
  "token_file": "/run/credentials/portwarden-inventory.service/token",
  "silent_after": "90s",
  "reprobe": "24h",
  "cloud": {
    "aws": true,
    "refresh": "10m",
    "regions": ["eu-west-1", "us-east-1"],
    "vpn_cidrs": ["81.2.69.160/28"]
  },
  "retention": {
    "history": "2160h",
    "quarantine": "720h",
    "interval": "1h",
    "batch": 1000
  }
}
