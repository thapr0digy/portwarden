{
  "nats": {
    "url": "tls://nats.example:4222",
    "nkey_file": "/run/credentials/portwarden-inventory.service/nats.nk",
    "ca_file": "/etc/portwarden/nats-ca.pem"
  },
  "postgres_dsn_file": "/run/credentials/portwarden-inventory.service/dsn",
  "listen": "127.0.0.1:8740",
  "token_file": "/run/credentials/portwarden-inventory.service/token",
  "silent_after": "90s",
  "reprobe": "24h",
  "cloud": {
    "aws": true,
    "refresh": "10m",
    "regions": ["eu-west-1", "us-east-1"],
    "gcp": {
      "enabled": true,
      "projects": ["acme-prod"],
      "hierarchy_confirmed": false,
      "key_file": "/run/credentials/portwarden-inventory.service/gcp-key"
    },
    "azure": {
      "enabled": true,
      "subscriptions": ["0b1c2d3e-4f50-6172-8394-a5b6c7d8e9f0"],
      "tenant_id": "72f988bf-86f1-41af-91ab-2d7cd011db47",
      "client_id": "a1b2c3d4-e5f6-4789-8abc-def012345678",
      "client_secret_file": "/run/credentials/portwarden-inventory.service/azure-secret"
    },
    "vpn_cidrs": ["81.2.69.160/28"]
  },
  "retention": {
    "history": "2160h",
    "quarantine": "720h",
    "interval": "1h",
    "batch": 1000
  }
}
