{
  "nats": {
    "url": "tls://nats.example:4222",
    "nkey_file": "/run/credentials/portwarden-verifier.service/nats.nk",
    "ca_file": "/etc/portwarden/nats-ca.pem"
  },
  "checker": "portwarden-verifier@probe-1.example",
  "allow_cidrs": ["203.0.113.0/24", "2001:db8:100::/48"],
  "host_addresses": {},
  "rate": { "global_per_second": 5, "per_host_per_minute": 30, "concurrency": 16, "queue": 1000 },
  "timeouts": { "connect": "3s", "banner": "2s" },
  "http_ports": [80, 8080],
  "user_agent": "portwarden-verifier/1 (+https://security.example/scanner)",
  "min_gap": "30s"
}
